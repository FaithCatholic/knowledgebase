eval "$(
    echo "$PLATFORM_RELATIONSHIPS" | base64 -d | jq -r '
        .dbmysql[0] |
        to_entries[] |
        select(.value != null and ((.value | type) == "string" or (.value | type) == "number" or (.value | type) == "boolean")) |
        "export MYSQL_" + (.key | ascii_upcase) + "=\"" + (.value | tostring) + "\"" '
)"

export PATH="${PLATFORM_APP_DIR}/vendor/bin:${PATH}"

# Set the URI for Drush commands.
export PRIMARY_URL="$(echo "$PLATFORM_ROUTES" | base64 --decode | jq -r 'to_entries[] | select(.value.primary) | .key | rtrimstr("/")')"
export DRUSH_OPTIONS_URI="$PRIMARY_URL"

# Unpack all the relationship data into easy-to-access env vars like
# DATABASE_HOST, DATABASE_PORT, etc.
# These will be named according to the service name in the
# platform `relationships:` yaml names.
eval "$(
  echo "$PLATFORM_RELATIONSHIPS" | base64 -d | jq -r '
    to_entries[] |
    .key as $service |
    .value[0] |
    to_entries[] |
    select(.value != null and ((.value | type) == "string" or (.value | type) == "number" or (.value | type) == "boolean")) |
    "export " + ($service | ascii_upcase) + "_" + (.key | ascii_upcase) + "=\"" + (.value | tostring) + "\""  '
)"

# Set database environment variables
export DB_HOST="$MYSQL_HOST"
export DB_PORT="$MYSQL_PORT"
export DB_PATH="$MYSQL_PATH"
export DB_DATABASE="$DB_PATH"
export DB_USERNAME="$MYSQL_USERNAME"
export DB_PASSWORD="$MYSQL_PASSWORD"
export DB_SCHEME="$MYSQL_SCHEME"
export DATABASE_URL="${DB_SCHEME}://${DB_USERNAME}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_PATH}"