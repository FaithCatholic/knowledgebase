<?php

/**
 * @file
 * Install, update and uninstall functions for KB Chat.
 */

/**
 * Implements hook_schema().
 */
function kb_chat_schema(): array {
  $schema['kb_chat_conversation'] = _kb_chat_conversation_schema();
  $schema['kb_chat_usage'] = [
    'description' => 'One AI provider call (chat or embeddings) and its estimated cost.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'uid' => [
        'description' => 'The user the call was made for; 0 for cron and indexing.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'provider' => [
        'description' => 'The AI provider plugin ID, such as anthropic or gemini.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'model' => [
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'operation' => [
        'description' => 'The AI operation type, such as chat or embeddings.',
        'type' => 'varchar_ascii',
        'length' => 64,
        'not null' => TRUE,
        'default' => '',
      ],
      'thread' => [
        'description' => 'The AI request thread ID, grouping the calls of one request.',
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'input_tokens' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'output_tokens' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'cache_read_tokens' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'cache_write_tokens' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'tokens_estimated' => [
        'description' => '1 if the provider reported no token counts and they were estimated from the text length.',
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
      ],
      'cost' => [
        'description' => 'Estimated cost in USD, or NULL if the model has no price in settings.',
        'type' => 'numeric',
        'precision' => 14,
        'scale' => 8,
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'created' => ['created'],
      'provider_created' => ['provider', 'created'],
    ],
  ];
  return $schema;
}

/**
 * Install the shared drive document entity type, for Google Drive documents.
 */
function kb_chat_update_11001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('kb_chat_document')) {
    $entity_type = \Drupal::entityTypeManager()->getDefinition('kb_chat_document');
    $manager->installEntityType($entity_type);
    return 'Installed the shared drive document entity type.';
  }
  return 'The shared drive document entity type was already installed.';
}

/**
 * Move the Drive sync's exclusions and limits from settings.php to config.
 *
 * They are now edited at Configuration > Search > KB chat Google Drive. The
 * service account keys stay in settings.php.
 */
function kb_chat_update_11002(): string {
  // settings.php no longer has these by the time this runs, so fall back to
  // the values it had.
  $old = (\Drupal\Core\Site\Settings::get('kb_chat')['drive'] ?? []) + [
    'exclude_drives' => ['Accounts Payable', 'Magazines'],
    'exclude_folders' => [],
    'exclude_names' => ['CONTACTS DATABASE', 'Christmas card list'],
  ];
  \Drupal::configFactory()->getEditable('kb_chat.drive')
    ->set('exclude_drives', array_values($old['exclude_drives']))
    ->set('exclude_folders', array_values($old['exclude_folders']))
    ->set('exclude_names', array_values($old['exclude_names']))
    ->set('list_interval', (int) ($old['list_interval'] ?? 21600))
    ->set('max_file_bytes', (int) ($old['max_file_bytes'] ?? 26214400))
    ->set('max_pdf_bytes', (int) ($old['max_pdf_bytes'] ?? 10485760))
    ->save();
  return 'Moved the Google Drive exclusions and limits from settings.php to configuration.';
}

/**
 * Register the trusted website entity type as installed.
 *
 * It was added after kb_chat was enabled. Being a config entity it needs no
 * tables, but the status report lists it until it is registered.
 */
function kb_chat_update_11003(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  if (!$manager->getEntityType('kb_chat_web_source')) {
    $manager->installEntityType(\Drupal::entityTypeManager()->getDefinition('kb_chat_web_source'));
    return 'Registered the trusted website entity type.';
  }
  return 'The trusted website entity type was already registered.';
}

/**
 * Remove the instructions editor's Markdown escapes from the AI agents.
 *
 * Saving runs kb_chat's ai_agent presave hook, which turns "\[Title]\(URL)"
 * back into "[Title](URL)" so the model sees the citation format as meant.
 */
function kb_chat_update_11004(): string {
  $cleaned = [];
  foreach (\Drupal::entityTypeManager()->getStorage('ai_agent')->loadMultiple() as $agent) {
    $before = (string) $agent->get('system_prompt');
    $agent->save();
    if ((string) $agent->get('system_prompt') !== $before) {
      $cleaned[] = $agent->label();
    }
  }
  return $cleaned ? 'Removed Markdown escapes from the instructions of: ' . implode(', ', $cleaned) . '.' : 'No agent instructions needed cleaning.';
}

/**
 * The table of "My searches" conversations.
 */
function _kb_chat_conversation_schema(): array {
  return [
    'description' => 'One question and its answer from the FAITH Search Agent, for the asker\'s "My searches".',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'uid' => [
        'description' => 'The user who asked.',
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ],
      'thread' => [
        'description' => 'The chat thread ID: one conversation.',
        'type' => 'varchar_ascii',
        'length' => 128,
        'not null' => TRUE,
        'default' => '',
      ],
      'question' => [
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'answer' => [
        'description' => 'The answer as Markdown, as shown in the chat.',
        'type' => 'text',
        'size' => 'medium',
        'not null' => TRUE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'uid_thread' => ['uid', 'thread'],
      'created' => ['created'],
    ],
  ];
}

/**
 * Add "My searches", and keep each user's conversation for 7 days.
 *
 * Creates the conversation table. Switches the KB Chat assistant from
 * "multiple threads" memory, which started a new thread on every page load,
 * to a single ongoing thread per user that lasts 7 days (until Clear
 * history), with the last 10 exchanges sent to Claude as context.
 */
function kb_chat_update_11005(): string {
  $schema = \Drupal::database()->schema();
  if (!$schema->tableExists('kb_chat_conversation')) {
    $schema->createTable('kb_chat_conversation', _kb_chat_conversation_schema());
  }
  $config = \Drupal::configFactory()->getEditable('ai_assistant_api.ai_assistant.kb_chat');
  if ($config->isNew()) {
    return 'Created the My searches table. The KB Chat assistant was not found, so its memory was not changed.';
  }
  $config->set('allow_history', 'private_tempstore')
    ->set('chat_memory_settings', ['expiry' => 604800, 'max_messages' => 10])
    ->save();
  return 'Created the My searches table, and set the KB Chat assistant to keep one conversation per user for 7 days.';
}
