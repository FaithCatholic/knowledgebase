{#
/**
 * @file
 * Upsun hosting dashboard.
 *
 * Available variables:
 * - rows: One entry per project, built by DashboardController::buildRow().
 * - summary: Counts for the cards above the table, plus 'cost', this
 *   month's total across all billing profiles.
 * - billing: One entry per billing profile, for the table under the projects.
 * - updated: When the data was last collected, or NULL if never.
 * - configured: Whether UPSUN_API_TOKEN is set.
 * - refresh_link: Link that refreshes the data in a batch.
 */
#}
{% macro usage(item, suffix) %}
  {% if item.percent is not null %}
    {% if item.level %}
      <span class="badge text-bg-{{ item.level }}">{{ item.percent }}%</span>
    {% else %}
      {{ item.percent }}%
    {% endif %}
    {% if suffix %}<small class="text-body-secondary">{{ suffix }}</small>{% endif %}
  {% else %}
    <span class="text-body-secondary">–</span>
  {% endif %}
{% endmacro %}
{% import _self as dashboard %}

<div class="upsun-dashboard">

  {% if not configured %}
    <div class="alert alert-warning">
      {{ 'The <code>UPSUN_API_TOKEN</code> environment variable is not set, so the dashboard cannot collect data.'|t }}
    </div>
  {% endif %}

  <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
    <p class="mb-0 text-body-secondary">
      {% if updated %}
        {{ 'Data collected @updated. Usage is the average over the last hour.'|t({'@updated': updated}) }}
      {% else %}
        {{ 'No data collected yet.'|t }}
      {% endif %}
    </p>
    {% if configured %}{{ refresh_link }}{% endif %}
  </div>

  {% if rows %}
    <div class="d-flex flex-wrap gap-2 mb-4 summary">
      {% for card in [
        {label: 'This month (est.)'|t, count: summary.cost ?: '–', level: null},
        {label: 'Projects'|t, count: summary.projects, level: null},
        {label: 'On Drupal 11'|t, count: summary.drupal_current, level: 'success'},
        {label: 'Older Drupal'|t, count: summary.drupal_behind, level: summary.drupal_behind ? 'warning' : null},
        {label: 'PHP below 8.3'|t, count: summary.php_behind, level: summary.php_behind ? 'warning' : null},
        {label: 'Disk or memory ≥ 80%'|t, count: summary.resources_high, level: summary.resources_high ? 'danger' : null},
        {label: 'Errors or warnings'|t, count: summary.errors, level: summary.errors ? 'danger' : null},
      ] %}
        <div class="card{{ card.level ? ' border-' ~ card.level }}">
          <div class="card-body">
            <div class="display-6{{ card.level ? ' text-' ~ card.level ~ '-emphasis' }}">{{ card.count }}</div>
            <div class="small text-body-secondary">{{ card.label }}</div>
          </div>
        </div>
      {% endfor %}
    </div>

    <div class="table-responsive">
      <table class="table table-sm table-hover align-top">
        <thead>
          <tr>
            <th scope="col">{{ 'Project'|t }}</th>
            <th scope="col">{{ 'Production'|t }}</th>
            <th scope="col">{{ 'Drupal'|t }}</th>
            <th scope="col">{{ 'PHP'|t }}</th>
            <th scope="col">{{ 'Services'|t }}</th>
            <th scope="col">{{ 'CPU'|t }}</th>
            <th scope="col">{{ 'Memory'|t }}</th>
            <th scope="col">{{ 'Disk'|t }}</th>
            <th scope="col" class="text-end">{{ 'This month'|t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for row in rows %}
            <tr{% if row.error %} class="table-danger"{% endif %}>
              <td>
                <strong>
                  {% if row.url %}<a href="{{ row.url }}">{{ row.title }}</a>{% else %}{{ row.title }}{% endif %}
                </strong>
                <div class="small text-body-secondary">
                  {{ row.org }} · {{ row.plan }} · {{ row.region }}
                  {% if row.console_url %}· <a href="{{ row.console_url }}">{{ 'Console'|t }}</a>{% endif %}
                </div>
                {% if row.error %}
                  <div class="small text-danger-emphasis">
                    {{ row.error }}{% if row.stale %} ({{ 'showing older data'|t }}){% endif %}
                  </div>
                {% endif %}
                {% for warning in row.warnings %}
                  <div class="small text-warning-emphasis">{{ warning }}</div>
                {% endfor %}
                {% set details_id = 'upsun-' ~ row.id|clean_id %}
                <div class="d-flex gap-1 mt-1">
                  {% if row.domains is not null %}
                    <button class="btn btn-sm btn-outline-{{ row.domains_level ?: 'secondary' }} py-0 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ details_id }}-domains" aria-expanded="false" aria-controls="{{ details_id }}-domains">
                      {{ 'Domains (@count)'|t({'@count': row.domains|length}) }}
                    </button>
                  {% endif %}
                  {% if row.users is not null %}
                    <button class="btn btn-sm btn-outline-{{ row.users_level ?: 'secondary' }} py-0 collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#{{ details_id }}-users" aria-expanded="false" aria-controls="{{ details_id }}-users">
                      {{ 'Users (@count)'|t({'@count': row.users|length}) }}
                    </button>
                  {% endif %}
                </div>
              </td>
              <td>
                {% if row.environment %}
                  {{ row.environment }}
                  <span class="badge text-bg-{{ row.environment_level }}">{{ row.environment_status }}</span>
                  {% if row.commit_date %}
                    <div class="small text-body-secondary">{{ 'Last commit @date'|t({'@date': row.commit_date}) }}</div>
                  {% endif %}
                {% endif %}
              </td>
              <td>
                {% if row.drupal %}
                  <span class="badge text-bg-{{ row.drupal_level }}">{{ row.drupal }}</span>
                  {% if row.drush %}<div class="small text-body-secondary">Drush {{ row.drush }}</div>{% endif %}
                {% else %}
                  <span class="text-body-secondary">–</span>
                {% endif %}
              </td>
              <td>
                {% if row.php %}
                  <span class="badge text-bg-{{ row.php_level }}">{{ row.php }}</span>
                {% else %}
                  <span class="text-body-secondary">–</span>
                {% endif %}
              </td>
              <td>
                {% for service in row.services %}
                  <div class="text-nowrap">{{ service }}</div>
                {% endfor %}
              </td>
              {% for metric in ['cpu', 'memory', 'disk'] %}
                <td class="usage">
                  {% for container in row.containers %}
                    <div>
                      <span class="usage-name">{{ container.name }}</span>
                      {{ dashboard.usage(container[metric], metric == 'disk' ? container.disk.detail : null) }}
                    </div>
                  {% endfor %}
                </td>
              {% endfor %}
              <td class="text-end usage">
                {{ row.cost ?: '–' }}
                {% if row.cost_previous %}
                  <div class="small text-body-secondary">{{ 'Last month @amount'|t({'@amount': row.cost_previous}) }}</div>
                {% endif %}
              </td>
            </tr>
            <tr class="upsun-details">
              <td colspan="9">
                {% if row.domains is not null %}
                  <div class="collapse" id="{{ details_id }}-domains">
                    <div class="details-panel">
                      <h3 class="h6">{{ 'Domains'|t }}</h3>
                      {% if row.domains %}
                        <table class="table table-sm w-auto mb-0">
                          <thead>
                            <tr>
                              <th scope="col">{{ 'Domain'|t }}</th>
                              <th scope="col">{{ 'Type'|t }}</th>
                              <th scope="col">{{ 'Certificate'|t }}</th>
                              <th scope="col">{{ 'Expires'|t }}</th>
                            </tr>
                          </thead>
                          <tbody>
                            {% for domain in row.domains %}
                              <tr>
                                <td><a href="https://{{ domain.name }}/">{{ domain.name }}</a></td>
                                <td>{{ domain.type }}</td>
                                <td>{{ domain.ssl_issuer ?: '–' }}</td>
                                <td class="usage">
                                  {{ domain.ssl_expires }}
                                  {% if domain.ssl_level %}
                                    <span class="badge text-bg-{{ domain.ssl_level }}">{{ domain.ssl_status }}</span>
                                  {% else %}
                                    <small class="text-body-secondary">{{ domain.ssl_status }}</small>
                                  {% endif %}
                                </td>
                              </tr>
                            {% endfor %}
                          </tbody>
                        </table>
                      {% else %}
                        <p class="small text-body-secondary mb-0">{{ 'No custom domains. The site uses its Upsun default URL.'|t }}</p>
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
                {% if row.users is not null %}
                  <div class="collapse" id="{{ details_id }}-users">
                    <div class="details-panel">
                      <h3 class="h6">{{ 'Users'|t }}</h3>
                      <table class="table table-sm w-auto mb-0">
                        <thead>
                          <tr>
                            <th scope="col">{{ 'Name'|t }}</th>
                            <th scope="col">{{ 'Email'|t }}</th>
                            <th scope="col">{{ 'Project role'|t }}</th>
                            <th scope="col">{{ 'Environment roles'|t }}</th>
                            <th scope="col">{{ 'MFA'|t }}</th>
                            <th scope="col">{{ 'Added'|t }}</th>
                          </tr>
                        </thead>
                        <tbody>
                          {% for user in row.users %}
                            <tr>
                              <td>
                                {{ user.name }}
                                {% if user.owner %}<span class="badge text-bg-secondary">{{ 'Org owner'|t }}</span>{% endif %}
                              </td>
                              <td>{% if user.email %}<a href="mailto:{{ user.email }}">{{ user.email }}</a>{% endif %}</td>
                              <td>{{ user.role }}</td>
                              <td class="small">{{ user.environment_roles ?: '–' }}</td>
                              <td>
                                {% if user.mfa %}
                                  <span class="badge text-bg-success">{{ 'On'|t }}</span>
                                {% elseif user.sso %}
                                  <span class="badge text-bg-secondary">{{ 'SSO'|t }}</span>
                                {% else %}
                                  <span class="badge text-bg-warning">{{ 'Off'|t }}</span>
                                {% endif %}
                              </td>
                              <td class="usage">{{ user.granted ?: '–' }}</td>
                            </tr>
                          {% endfor %}
                        </tbody>
                      </table>
                    </div>
                  </div>
                {% endif %}
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if billing %}
    <h2 class="h5 mt-4">{{ 'Billing'|t }}</h2>
    <p class="small text-body-secondary">
      {{ 'From each billing profile’s open invoice. Subscription charges are for the whole month; usage charges keep growing until the month ends. Org-level charges are support, user licenses and discounts that aren’t tied to one project.'|t }}
    </p>
    <div class="table-responsive">
      <table class="table table-sm w-auto">
        <thead>
          <tr>
            <th scope="col">{{ 'Organizations'|t }}</th>
            <th scope="col">{{ 'Month'|t }}</th>
            <th scope="col" class="text-end">{{ 'Projects'|t }}</th>
            <th scope="col" class="text-end">{{ 'Org-level'|t }}</th>
            <th scope="col" class="text-end">{{ 'Total'|t }}</th>
            <th scope="col" class="text-end">{{ 'Last month'|t }}</th>
          </tr>
        </thead>
        <tbody>
          {% for profile in billing %}
            <tr>
              <td>
                {{ profile.orgs }}
                {% if profile.error %}<div class="small text-danger-emphasis">{{ profile.error }}</div>{% endif %}
              </td>
              <td>{{ profile.period ?: '–' }}</td>
              <td class="text-end usage">{{ profile.projects ?: '–' }}</td>
              <td class="text-end usage">{{ profile.unassigned ?: '–' }}</td>
              <td class="text-end usage"><strong>{{ profile.total ?: '–' }}</strong></td>
              <td class="text-end usage">{{ profile.previous ?: '–' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

</div>
